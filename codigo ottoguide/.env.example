# ════════════════════════════════════════════════════════════
# OttoGuide — Variables de entorno
# ════════════════════════════════════════════════════════════
# Copiar este archivo como .env y ajustar valores segun el entorno.
#   cp .env.example .env

# --- Modo de operacion ---
ROBOT_MODE=mock
# real → robot fisico (requiere ROBOT_NETWORK_INTERFACE)
# sim  → simulador MuJoCo (requiere unitree_mujoco en domain 1)
# mock → stub en memoria (CI/CD, sin procesos externos)

# --- Interfaz de red para DDS (solo si ROBOT_MODE=real) ---
ROBOT_NETWORK_INTERFACE=eth0
# Requerida solo si ROBOT_MODE=real

# --- NLP / LLM (Ollama local) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Cloud fallback (interlock fail-closed por defecto) ---
# CLOUD_FALLBACK_ENABLED=false
# false → cloud siempre bloqueado (defecto seguro para produccion air-gapped)
# true  → cloud permitido en ROBOT_MODE != real (requiere OPENAI_API_KEY o GEMINI_API_KEY)
# Nota: en ROBOT_MODE=real siempre bloqueado aunque CLOUD_FALLBACK_ENABLED=true

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Web UI React ---
WEB_UI_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
WEB_UI_PUBLIC_URL=http://localhost:3001
WEB_UI_ALLOW_MISSING_ORIGIN=false
# WEB_UI_ALLOWED_ORIGINS: lista CSV de origenes permitidos para CORS HTTP y para el header
#   Origin de /ws/telemetry (misma fuente de verdad para ambos).
#   - En ROBOT_MODE=real es OBLIGATORIO establecerla explicitamente: vacia o con "*" bloquea
#     el arranque del backend (WEB_UI_CONFIG_INVALID).
#   - En ROBOT_MODE=mock/sim/demo, si se deja vacia se usan automaticamente los defaults de
#     desarrollo (http://localhost:3001, http://127.0.0.1:3001).
#   - Nunca usar wildcard "*" en produccion/real.
# WEB_UI_PUBLIC_URL: URL a la que "/" y "/dashboard" redirigen cuando esta configurada
#   (React corre normalmente en la notebook, puerto 3001). Sin configurar, se sirve el
#   dashboard HTML legacy como fallback transicional.
# WEB_UI_ALLOW_MISSING_ORIGIN: permite conexiones WebSocket sin header Origin. Mantener en
#   false; solo util para pruebas controladas. No habilitar en produccion.
# Topologia tipica: React (notebook) :3001  <-->  FastAPI (companion PC) :8000

# ════════════════════════════════════════════════════════════
# Configuracion DDS para modo real (en entorno de sistema, no aqui):
# CYCLONEDDS_URI=<CycloneDDS><Domain><General>
#   <NetworkInterfaceAddress>eth0</NetworkInterfaceAddress>
#   </General><Discovery><Peers>
#   <Peer address="192.168.123.161"/>
#   </Peers></Discovery></Domain></CycloneDDS>
# Para modo sim, CycloneDDS usa loopback automaticamente con domain 1.
