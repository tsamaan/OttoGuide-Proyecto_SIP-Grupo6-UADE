<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ottoguide_unitree_capture_bridge</name>
  <version>0.1.0</version>
  <description>
    OttoGuide subscriber-only bridge between Unitree G1 native DDS HG channels
    and ROS 2 Foxy topics under /unitree/*.
    Does NOT publish /cmd_vel, /odom, /tf, or any Unitree command topic.
  </description>
  <maintainer email="LucasCap12@users.noreply.github.com">OttoGuide Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
