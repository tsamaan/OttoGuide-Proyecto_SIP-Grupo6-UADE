#!/usr/bin/env bash
# ottoguide-map — HIL capture tool for OttoGuide / Unitree G1 EDU 8
# =================================================================
# Modes: prep | start | timed | stop | status | finalize | package | plan | help
#
# Safety invariants (never violated):
#   - Does NOT publish /cmd_vel.
#   - Does NOT move the robot.
#   - Does NOT require /tf or /odom for raw capture.
#   - Blocks start/timed if /cmd_vel has active publishers (CMD_VEL_PUBLISHER_PRESENT).
#   - plan mode: dry-run only; no bag created.
#
# Topic selection: fully dynamic via ros2 topic list at runtime.
# Manifests: written to $SESSION/logs/ before every recording.
set -Eeuo pipefail

BASE_DEFAULT="/home/unitree/Desktop/Ottoguide/OttoGuide-Proyecto_SIP-Grupo6-UADE/codigo ottoguide"
BASE="${BASE:-$BASE_DEFAULT}"
ART="$BASE/artifacts"
LATEST="$ART/ottoguide_map_latest_run_id"
SENSOR_LATEST="$ART/sensor_stack_recovery_latest_session"

COMMAND="${1:-help}"
shift || true
LABEL="office_short_remote_control_raw"
DURATION=""
BAG_NAME=""

# ---------------------------------------------------------------------------
# Heavy topics: NOT sampled with topic echo --once (avoid memory/latency spike)
# ---------------------------------------------------------------------------
HEAVY_TOPIC_PATTERNS=(
  "/utlidar/cloud"
  "/scan"
  "/map"
  "/map_metadata"
  "image"
  "cloud"
  "point"
)

# ---------------------------------------------------------------------------
# Candidate topics: recorded if present in ros2 topic list
# Priority order is preserved; dedupe applied.
# ---------------------------------------------------------------------------
CANDIDATE_TOPICS=(
  # --- Sensor base (L0) ---
  /utlidar/cloud
  /livox/imu
  /scan
  # --- Unitree capture bridge ROS topics (L1 candidate) ---
  # These are published by ottoguide_unitree_capture_bridge, NOT by ros2 topic list on Unitree DDS.
  # They appear in ros2 topic list only when the capture bridge is running.
  /unitree/remote_joy
  /unitree/lowstate_imu
  /unitree/secondary_imu
  /unitree/fsm_state
  /unitree/lowstate_summary
  /unitree/sdk_health
  # --- Navigation / localization (L3) ---
  /tf
  /tf_static
  /odom
  /map
  /map_metadata
)

UNITREE_CAPTURE_TOPICS=(
  /unitree/remote_joy
  /unitree/lowstate_imu
  /unitree/secondary_imu
  /unitree/fsm_state
  /unitree/lowstate_summary
  /unitree/sdk_health
)

usage() {
  cat <<'USAGE'
Uso rapido:

1. Con robot encendido, parado/en piso y control remoto listo:
   ./tools/hil/ottoguide-map prep

2. Dry-run: ver que se grabaría SIN iniciar bag:
   ./tools/hil/ottoguide-map plan

3. Iniciar grabacion:
   ./tools/hil/ottoguide-map start --label "office_short_remote_control_raw"

4. Mover robot con control remoto humano.

5. Ver estado:
   ./tools/hil/ottoguide-map status

6. Detener:
   ./tools/hil/ottoguide-map stop

7. Finalizar:
   ./tools/hil/ottoguide-map finalize

8. Empaquetar:
   ./tools/hil/ottoguide-map package

Comandos:
  prep
  plan                         (dry-run: discovery sin bag)
  start --label LABEL [--bag-name NAME]
  timed --duration SECONDS --label LABEL [--bag-name NAME]
  status
  stop
  finalize
  package
  help

Variables de entorno:
  BASE=/ruta                   (base del codigo)
  ROS_DOMAIN_ID=N
  RMW_IMPLEMENTATION=rmw_...

Seguridad:
  No publica /cmd_vel. No mueve el robot.
  Bloquea si /cmd_vel o /odom tienen publishers activos.
  No requiere /tf ni /odom para captura raw.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --label|--route-label) LABEL="${2:?missing label}"; shift 2 ;;
    --duration) DURATION="${2:?missing duration}"; shift 2 ;;
    --bag-name) BAG_NAME="${2:?missing bag name}"; shift 2 ;;
    -h|--help) COMMAND="help"; shift ;;
    *) echo "Unknown arg: $1" >&2; usage; exit 2 ;;
  esac
done

# ---------------------------------------------------------------------------
# ROS 2 environment
# ---------------------------------------------------------------------------
load_ros() {
  set +u
  source /opt/ros/foxy/setup.bash
  if [[ -f "$BASE/ros2_ws/install/setup.bash" ]]; then
    source "$BASE/ros2_ws/install/setup.bash"
  fi
  set -u
  export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}"
  export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"
  export OTTOGUIDE_ROOT="$BASE"
  export LD_LIBRARY_PATH="/opt/ros/foxy/opt/yaml_cpp_vendor/lib:/opt/ros/foxy/opt/rviz_ogre_vendor/lib:/opt/ros/foxy/lib/aarch64-linux-gnu:/opt/ros/foxy/lib:/usr/local/lib:${LD_LIBRARY_PATH:-}"
  if [[ -z "${CYCLONEDDS_URI:-}" && -f "$BASE/config/cyclonedds.foxy.xml" ]]; then
    export CYCLONEDDS_URI="file://$BASE/config/cyclonedds.foxy.xml"
  fi
}

ros2_available() {
  command -v ros2 &>/dev/null
}

# ---------------------------------------------------------------------------
# Topic helpers
# ---------------------------------------------------------------------------
topic_exists() {
  ros2 topic list 2>/dev/null | grep -Fxq "$1"
}

print_topic_status() {
  for topic in /utlidar/cloud /livox/imu /scan /tf /tf_static /odom /map /map_metadata /cmd_vel; do
    if topic_exists "$topic"; then
      echo "PASS   $topic"
    else
      echo "MISS   $topic"
    fi
  done
}

is_heavy_topic() {
  local t="$1"
  for p in "${HEAVY_TOPIC_PATTERNS[@]}"; do
    if [[ "$t" == "$p" ]] || [[ "$t" == *"$p"* && "$p" != "/" ]]; then
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# /cmd_vel safety audit
# Returns 0 (ok to record) or 1 (BLOCKED)
# ---------------------------------------------------------------------------
cmd_vel_precheck() {
  local out_file="${1:-/dev/null}"
  {
    echo "CMD_VEL_PRECHECK at $(date)"
    if ! topic_exists /cmd_vel; then
      echo "STATUS: /cmd_vel NOT present — OK"
      echo "RESULT: OK_NOT_PRESENT"
      return 0
    fi
    echo "STATUS: /cmd_vel EXISTS"
    local info
    info=$(ros2 topic info /cmd_vel 2>/dev/null || true)
    echo "$info"
    if echo "$info" | grep -qE "Publisher count: [1-9]"; then
      echo "RESULT: CMD_VEL_PUBLISHER_PRESENT"
      return 1
    else
      echo "RESULT: OK_NO_PUBLISHERS"
      return 0
    fi
  } | tee "$out_file"
}

odom_precheck() {
  local out_file="${1:-/dev/null}"
  {
    echo "ODOM_PRECHECK at $(date)"
    if ! topic_exists /odom; then
      echo "RESULT: OK_NOT_PRESENT"
      return 0
    fi
    local info
    info=$(ros2 topic info /odom 2>/dev/null || true)
    echo "$info"
    if echo "$info" | grep -qE "Publisher count: [1-9]"; then
      echo "RESULT: ODOM_PUBLISHER_PRESENT"
      return 1
    fi
    echo "RESULT: OK_NO_PUBLISHERS"
  } | tee "$out_file"
}

require_unitree_capture_topics() {
  local topics topic missing=0
  topics=$(ros2 topic list 2>/dev/null || true)
  for topic in "${UNITREE_CAPTURE_TOPICS[@]}"; do
    if ! grep -Fxq "$topic" <<<"$topics"; then
      echo "MISSING_UNITREE_CAPTURE_TOPIC=$topic" >&2
      missing=1
    fi
  done
  [[ "$missing" == "0" ]]
}

assert_no_navigation_processes() {
  ! pgrep -af 'nav2|bt_navigator|controller_server|planner_server|slam_toolbox' >/dev/null
}

# ---------------------------------------------------------------------------
# Dynamic topic discovery
# discover_record_topics -> writes deduplicated list to $1
# ---------------------------------------------------------------------------
discover_record_topics() {
  local out_file="$1"
  local all_topics
  all_topics=$(ros2 topic list 2>/dev/null || true)

  # Temporary file for ordered candidates
  local tmp_ordered
  tmp_ordered=$(mktemp)

  # 1. Add mandatory candidates if they exist (priority order preserved)
  for topic in "${CANDIDATE_TOPICS[@]}"; do
    if echo "$all_topics" | grep -Fxq "$topic"; then
      echo "$topic" >> "$tmp_ordered"
    fi
  done

  # 2. Dedupe preserving first occurrence order, write to output
  awk '!seen[$0]++' "$tmp_ordered" > "$out_file"
  rm -f "$tmp_ordered"
}

# ---------------------------------------------------------------------------
# Topic manifest: info, type, interface show, samples for light topics
# ---------------------------------------------------------------------------
dump_topic_manifest() {
  local session_logs="$1"
  local topics_file="$2"
  local manifest_file="$session_logs/topic_manifest.txt"
  local samples_file="$session_logs/topic_samples_once.txt"

  echo "=== TOPIC MANIFEST $(date) ===" > "$manifest_file"
  echo "=== TOPIC SAMPLES $(date) ===" > "$samples_file"

  while IFS= read -r topic || [[ -n "$topic" ]]; do
    [[ -z "$topic" ]] && continue

    # -- topic info -v
    {
      echo ""
      echo "--- topic info: $topic ---"
      ros2 topic info -v "$topic" 2>/dev/null || echo "(info unavailable)"
    } >> "$manifest_file"

    # -- topic type
    local ttype
    ttype=$(ros2 topic type "$topic" 2>/dev/null || echo "(type unavailable)")
    echo "TYPE $topic : $ttype" >> "$manifest_file"

    # -- interface show
    if [[ "$ttype" != "(type unavailable)" && -n "$ttype" ]]; then
      {
        echo "--- interface show: $ttype ---"
        ros2 interface show "$ttype" 2>/dev/null || echo "(interface unavailable)"
      } >> "$manifest_file"
    fi

    # -- sample (light topics only)
    if is_heavy_topic "$topic"; then
      echo "SKIP_HEAVY $topic" >> "$samples_file"
    else
      {
        echo ""
        echo "--- sample: $topic ---"
        timeout 3 ros2 topic echo --once "$topic" 2>/dev/null || echo "(sample timeout or unavailable)"
      } >> "$samples_file"
    fi

  done < "$topics_file"

  echo "Manifest: $manifest_file"
  echo "Samples:  $samples_file"
}

# ---------------------------------------------------------------------------
# Pre-record context snapshot
# ---------------------------------------------------------------------------
pre_record_audit() {
  local session_logs="$1"
  {
    echo "PRE_RECORD_CONTEXT at $(date)"
    hostname 2>/dev/null || true
    whoami 2>/dev/null || true
    echo "BASE=$BASE"
    echo "LABEL=$LABEL"
    echo "ROS_DISTRO=${ROS_DISTRO:-}"
    echo "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-}"
    echo "RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-}"
    echo "CYCLONEDDS_URI=${CYCLONEDDS_URI:-}"
  } > "$session_logs/pre_record_context.txt"

  # Full topic list before record
  ros2 topic list 2>/dev/null | sort > "$session_logs/topic_list_before_record.txt" || true
  echo "Pre-record context written to $session_logs/"
}

# ---------------------------------------------------------------------------
# Sensor helpers
# ---------------------------------------------------------------------------
sensor_stack_alive() {
  pgrep -af "ros2 launch .*scan_gate.launch.py|livox_sdk_bridge_node|pointcloud_to_laserscan_node" >/dev/null 2>&1
}

start_sensor_stack() {
  RUN_ID="$(date +%Y%m%d_%H%M%S)"
  SESSION="$ART/sensor_stack_recovery_$RUN_ID"
  mkdir -p "$SESSION/logs" "$SESSION/state"
  echo "$SESSION" > "$SENSOR_LATEST"
  (
    cd "$BASE"
    load_ros
    export OTTOGUIDE_ROOT="$BASE"
    ros2 launch ottoguide_livox_sdk_bridge scan_gate.launch.py
  ) > "$SESSION/logs/sensor_stack.log" 2>&1 &
  SENSOR_PID=$!
  echo "$SENSOR_PID" > "$SESSION/state/sensor_stack_pid.txt"
  echo "Started sensor stack: PID=$SENSOR_PID SESSION=$SESSION"
  sleep 8
}

# ---------------------------------------------------------------------------
# COMMAND: prep
# ---------------------------------------------------------------------------
prep() {
  cd "$BASE"
  load_ros

  if pgrep -f livox_ros_driver2 >/dev/null 2>&1; then
    echo "PREP FAIL: livox_ros_driver2 is active. Must use scan_gate stack instead." >&2
    exit 3
  fi
  mkdir -p "$ART"
  echo "ROS_DISTRO=${ROS_DISTRO:-}"
  echo "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-}"
  echo "RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-}"
  echo "CYCLONEDDS_URI=${CYCLONEDDS_URI:-}"

  echo ""
  echo "Current topics:"
  ros2 topic list | sort || true

  if topic_exists /utlidar/cloud && topic_exists /scan; then
    echo "Sensor stack already available. Not relaunching."
  else
    echo "Sensor topics missing; attempting sensor-only scan_gate stack."
    start_sensor_stack
  fi

  echo ""
  echo "Post-prep topics:"
  ros2 topic list | sort || true
  print_topic_status

  if ! topic_exists /utlidar/cloud && ! topic_exists /scan; then
    echo "PREP FAIL: neither /utlidar/cloud nor /scan is available" >&2
    exit 3
  fi

  if topic_exists /cmd_vel; then
    if ros2 topic info /cmd_vel 2>/dev/null | grep -qE "Publisher count: [1-9]"; then
      echo "PREP FAIL: /cmd_vel has active publishers." >&2
      exit 3
    fi
  fi
  odom_precheck /dev/null || {
    echo "PREP FAIL: /odom has active publishers." >&2
    exit 3
  }
  assert_no_navigation_processes || {
    echo "PREP FAIL: Nav2 or SLAM process detected." >&2
    exit 3
  }

  if ! topic_exists /tf || ! topic_exists /tf_static; then
    echo "PREP PARTIAL: /tf or /tf_static missing. Raw capture allowed; direct map export not guaranteed."
  fi
  echo "PREP PASS: raw sensor capture ready if robot is physically safe."
}

# ---------------------------------------------------------------------------
# COMMAND: plan (dry-run — no bag created, no movement, no publishing)
# ---------------------------------------------------------------------------
plan_dryrun() {
  echo "=== PLAN MODE (dry-run) ==="
  echo "No bag will be created. No movement. No publishing."
  echo ""

  if ! ros2_available; then
    echo "ROS2_NOT_AVAILABLE_FOR_PLAN"
    echo "Install ROS 2 or run this command on the robot host."
    exit 4
  fi

  load_ros 2>/dev/null || true

  echo "ROS_DISTRO=${ROS_DISTRO:-}"
  echo "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-}"
  echo "RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-}"
  echo ""

  echo "=== Topics currently available ==="
  local all_topics
  all_topics=$(ros2 topic list 2>/dev/null || true)
  if [[ -z "$all_topics" ]]; then
    echo "(no topics — ROS 2 may not be running)"
  else
    echo "$all_topics" | sort
  fi

  echo ""
  echo "=== ROS TOPICS DISCOVERED (would record) ==="
  local tmp_file
  tmp_file=$(mktemp)
  discover_record_topics "$tmp_file" 2>/dev/null || true
  if [[ -s "$tmp_file" ]]; then
    # Show sensor base and unitree bridge topics separately for clarity
    echo "--- Sensor base ---"
    grep -E '^/utlidar/|^/livox/|^/scan$' "$tmp_file" || echo "  (none)"
    echo "--- Unitree capture bridge (/unitree/*) ---"
    grep -E '^/unitree/' "$tmp_file" || echo "  (none — start capture bridge first)"
    echo "--- Other ROS topics ---"
    grep -vE '^/utlidar/|^/livox/|^/scan$|^/unitree/' "$tmp_file" || echo "  (none)"
    echo ""
    echo "Total topics would be recorded: $(wc -l < "$tmp_file")"
  else
    echo "(no matching topics found)"
  fi
  rm -f "$tmp_file"

  echo ""
  echo "=== NATIVE DDS CHANNELS EXPECTED VIA CAPTURE BRIDGE ==="
  echo "  These channels are subscribed by the native tap (unitree_capture_tap)."
  echo "  They are NOT visible in ros2 topic list — only accessible via Unitree SDK2."
  echo "  DDS domain: 0, interface: eth0"
  echo "  rt/lowstate         ~1052 Hz  (IMU + wireless_remote + mode_machine)"
  echo "  rt/secondary_imu    ~1052 Hz  (torso IMU)"
  echo "  rt/sportmodestate   ~100 Hz   (FSM mode)"
  echo "  rt/lf/lowstate      optional diagnostic channel; never remote source"
  echo "  NOTE: These topics do NOT appear in ros2 topic list."
  echo "        Use 'unitree-capture-bridge plan' for native tap status."

  echo ""
  echo "=== /cmd_vel audit ==="
  local tmp_cv
  tmp_cv=$(mktemp)
  if cmd_vel_precheck "$tmp_cv" >/dev/null 2>&1; then
    echo "cmd_vel: OK"
  else
    echo "cmd_vel: CMD_VEL_PUBLISHER_PRESENT — would block recording"
  fi
  rm -f "$tmp_cv"

  echo ""
  echo "=== /odom audit ==="
  if odom_precheck /dev/null >/dev/null 2>&1; then
    echo "odom: OK"
  else
    echo "odom: ODOM_PUBLISHER_PRESENT — would block recording"
  fi

  echo ""
  echo "=== Capture bridge completeness ==="
  if require_unitree_capture_topics; then
    echo "unitree capture topics: COMPLETE"
  else
    echo "unitree capture topics: INCOMPLETE — would block recording"
  fi

  echo ""
  echo "=== Nav2 / SLAM audit ==="
  if assert_no_navigation_processes; then
    echo "navigation processes: NONE"
  else
    echo "navigation processes: PRESENT — would block recording"
  fi

  echo ""
  echo "=== PLAN COMPLETE — no bag started ==="
}

# ---------------------------------------------------------------------------
# Session helpers
# ---------------------------------------------------------------------------
new_run() {
  RUN_ID="$(date +%Y%m%d_%H%M%S)"
  SESSION="$ART/ottoguide_map_$RUN_ID"
  mkdir -p "$SESSION/logs" "$SESSION/rosbags" "$SESSION/maps/raw" "$SESSION/maps/cleaned" "$SESSION/state" "$SESSION/manifests" "$SESSION/reports"
  echo "$RUN_ID" > "$LATEST"
  echo "$SESSION" > "$SESSION/state/session_dir.txt"
  echo "$LABEL" > "$SESSION/state/route_label.txt"
}

get_latest() {
  if [[ ! -f "$LATEST" ]]; then
    echo "No latest run id found: $LATEST" >&2
    exit 1
  fi
  RUN_ID="$(cat "$LATEST")"
  SESSION="$ART/ottoguide_map_$RUN_ID"
  if [[ ! -d "$SESSION" ]]; then
    echo "Session dir not found: $SESSION" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# COMMAND: start / timed (internal: start_recording)
# ---------------------------------------------------------------------------
start_recording() {
  cd "$BASE"
  load_ros

  if ! topic_exists /utlidar/cloud && ! topic_exists /scan; then
    echo "START REFUSED: neither /utlidar/cloud nor /scan exists. Run prep first." >&2
    exit 3
  fi

  cmd_vel_precheck /dev/null || {
    echo "START REFUSED: CMD_VEL_PUBLISHER_PRESENT" >&2
    exit 3
  }
  odom_precheck /dev/null || {
    echo "START REFUSED: ODOM_PUBLISHER_PRESENT" >&2
    exit 3
  }
  assert_no_navigation_processes || {
    echo "START REFUSED: NAV2_OR_SLAM_PROCESS_PRESENT" >&2
    exit 3
  }
  require_unitree_capture_topics || {
    echo "START REFUSED: UNITREE_CAPTURE_TOPICS_INCOMPLETE" >&2
    exit 3
  }

  new_run

  # --- Pre-record audit ------------------------------------------------
  pre_record_audit "$SESSION/logs"
  cmd_vel_precheck "$SESSION/logs/cmd_vel_precheck.txt"
  odom_precheck "$SESSION/logs/odom_precheck.txt"

  # --- Dynamic topic discovery -----------------------------------------
  local topics_file="$SESSION/logs/topics_selected_for_record.txt"
  discover_record_topics "$topics_file"

  if ! grep -Fxq /utlidar/cloud "$topics_file" && ! grep -Fxq /scan "$topics_file"; then
    echo "START REFUSED: no raw sensor topics selected after discovery" >&2
    exit 3
  fi

  # --- Topic manifest ---------------------------------------------------
  dump_topic_manifest "$SESSION/logs" "$topics_file"

  # --- Save exact record command ----------------------------------------
  local bag_dir="$SESSION/rosbags/${BAG_NAME:-ottoguide_map_$RUN_ID}"
  echo "$bag_dir" > "$SESSION/state/bag_dir.txt"
  mapfile -t TOPICS < "$topics_file"
  local rec_cmd="ros2 bag record -o $bag_dir ${TOPICS[*]}"
  echo "$rec_cmd" > "$SESSION/logs/rosbag_record_command.txt"

  echo "Recording topics:"
  cat "$topics_file"
  echo ""
  echo "Command: $rec_cmd"
  echo ""

  ros2 bag record -o "$bag_dir" "${TOPICS[@]}" > "$SESSION/logs/rosbag_record.log" 2>&1 &
  BAG_PID=$!
  echo "$BAG_PID" > "$SESSION/state/rosbag_pid.txt"
  echo "RUN_ID=$RUN_ID"
  echo "SESSION=$SESSION"
  echo "BAG_DIR=$bag_dir"
  echo "Recording started."
  echo ""
  echo "Use:"
  echo "  ./tools/hil/ottoguide-map status"
  echo "  ./tools/hil/ottoguide-map stop"
  echo "  ./tools/hil/ottoguide-map finalize"
  echo "  ./tools/hil/ottoguide-map package"
}

# ---------------------------------------------------------------------------
# COMMAND: stop
# ---------------------------------------------------------------------------
stop_recording() {
  cd "$BASE"
  load_ros
  get_latest
  local bag_pid
  bag_pid="$(cat "$SESSION/state/rosbag_pid.txt" 2>/dev/null || true)"
  local bag_dir
  bag_dir="$(cat "$SESSION/state/bag_dir.txt" 2>/dev/null || true)"

  if [[ -n "$bag_pid" ]] && ps -p "$bag_pid" >/dev/null 2>&1; then
    echo "Stopping rosbag PID=$bag_pid with SIGINT"
    kill -INT "$bag_pid"
    while ps -p "$bag_pid" >/dev/null 2>&1; do
      sleep 1
    done
  else
    echo "No live rosbag PID found."
  fi

  if [[ -n "$bag_dir" && -d "$bag_dir" ]]; then
    ros2 bag info "$bag_dir" > "$SESSION/logs/rosbag_info.log" 2>&1 || true
    cat "$SESSION/logs/rosbag_info.log" || true
  fi
  generate_manifests
}

# ---------------------------------------------------------------------------
# COMMAND: finalize
# ---------------------------------------------------------------------------
finalize_run() {
  cd "$BASE"
  load_ros
  get_latest
  local bag_dir
  bag_dir="$(cat "$SESSION/state/bag_dir.txt" 2>/dev/null || true)"

  if [[ -n "$bag_dir" && -d "$bag_dir" && ! -f "$SESSION/logs/rosbag_info.log" ]]; then
    ros2 bag info "$bag_dir" > "$SESSION/logs/rosbag_info.log" 2>&1 || true
  fi
  generate_manifests

  local map_base="$SESSION/maps/raw/ottoguide_map_$RUN_ID"
  if topic_exists /map; then
    ros2 run nav2_map_server map_saver_cli -f "$map_base" > "$SESSION/logs/map_saver.log" 2>&1 || true
  else
    echo "MAP_EXPORT_SKIPPED_NO_MAP_TOPIC" > "$SESSION/logs/map_saver.log"
  fi

  cat > "$SESSION/README.md" <<README
# OttoGuide map/raw sensor capture

RUN_ID: $RUN_ID
Label: $(cat "$SESSION/state/route_label.txt" 2>/dev/null || true)
Session: $SESSION
Bag: $bag_dir

This is a raw sensor capture. It can be replayed offline.
If /tf or /map were missing during capture, direct map export is not guaranteed.
The agent did not publish /cmd_vel and did not move the robot.
README
  echo "FINALIZED SESSION=$SESSION"
  cat "$SESSION/logs/map_saver.log" || true
}

# ---------------------------------------------------------------------------
# COMMAND: status
# ---------------------------------------------------------------------------
status_run() {
  cd "$BASE"
  load_ros
  get_latest
  local bag_dir
  bag_dir="$(cat "$SESSION/state/bag_dir.txt" 2>/dev/null || true)"
  local bag_pid
  bag_pid="$(cat "$SESSION/state/rosbag_pid.txt" 2>/dev/null || true)"

  echo "RUN_ID=$RUN_ID"
  echo "SESSION=$SESSION"
  echo "BAG_DIR=$bag_dir"

  if [[ -n "$bag_pid" ]]; then
    if ps -p "$bag_pid" >/dev/null 2>&1; then
      echo "ROSBag PID $bag_pid ALIVE"
    else
      echo "ROSBag PID $bag_pid NOT alive"
    fi
  fi

  du -sh "$bag_dir" 2>/dev/null || true

  if [[ -f "$SESSION/logs/topics_selected_for_record.txt" ]]; then
    echo ""
    echo "Topics selected for record:"
    cat "$SESSION/logs/topics_selected_for_record.txt"
  fi

  echo ""
  echo "Recent rosbag log:"
  tail -40 "$SESSION/logs/rosbag_record.log" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Manifests (SHA256 + file sizes)
# ---------------------------------------------------------------------------
generate_manifests() {
  get_latest
  find "$SESSION" -type f -printf "%s %p\n" | sort -nr > "$SESSION/manifests/FILES_SIZES.txt" || true
  (cd "$SESSION" && find . -type f ! -path './manifests/SHA256SUMS.txt' -print0 | sort -z | xargs -0 sha256sum) > "$SESSION/manifests/SHA256SUMS.txt" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# COMMAND: package
# ---------------------------------------------------------------------------
package_run() {
  get_latest
  local tar="/tmp/ottoguide_map_${RUN_ID}.tar.gz"
  tar -czf "$tar" -C "$ART" "ottoguide_map_$RUN_ID"
  sha256sum "$tar" > "$tar.sha256"
  echo "TAR=$tar"
  echo "SHA256=$tar.sha256"
  echo ""
  echo "PowerShell copy (from Windows):"
  echo "  scp -i \"\$env:USERPROFILE\\.ssh\\id_ed25519_ottoguide_robot\" unitree@192.168.123.164:$tar \"C:\\Users\\lucas\\Documents\\OttoGuide-Proyecto_SIP-Grupo6-UADE\\artifacts\\\""
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
case "$COMMAND" in
  prep)     prep ;;
  plan)     plan_dryrun ;;
  start)    start_recording ;;
  timed)
    if [[ -z "$DURATION" ]]; then
      echo "--duration required for timed" >&2; exit 2
    fi
    start_recording
    sleep "$DURATION"
    stop_recording
    ;;
  status)   status_run ;;
  stop)     stop_recording ;;
  finalize) finalize_run ;;
  package)  package_run ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $COMMAND" >&2; usage; exit 2 ;;
esac
