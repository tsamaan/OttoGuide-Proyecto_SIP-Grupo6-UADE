# ════════════════════════════════════════════════════════════════════════════
# OttoGuide — Offline Autonomous Navigation Profile
# ════════════════════════════════════════════════════════════════════════════
#
# This file documents the environment variables that govern the offline
# autonomous navigation subsystem (DirectNav2ActionBridge + Nav2 sandbox).
# It is NOT a secret file — copy it as .env.offline_nav and adjust values.
#
#   cp .env.offline_nav.example .env.offline_nav
#
# Constraints that MUST remain in force during offline operation:
#   - ROBOT_MODE must NOT be set to "real"
#   - NAVIGATION_DIRECT_REAL_ENABLED must NOT be set to "true"
#   - The stack runs entirely inside WSL (ROS_LOCALHOST_ONLY=1)
#   - ROS_DOMAIN_ID must be a dedicated value != 0 (default 77)
#   - No physical cmd_vel publisher may be active (assert_no_cmd_vel_publishers.sh)

# ---------------------------------------------------------------------------
# Execution mode
# ---------------------------------------------------------------------------
ROBOT_MODE=mock
# Allowed values for offline nav: mock | sim
# "real" is prohibited in offline operation.

# ---------------------------------------------------------------------------
# Navigation backend selection
# ---------------------------------------------------------------------------
NAVIGATION_BACKEND=direct
# "direct" → DirectNav2ActionBridge (NavigateToPose + FollowWaypoints)
# "stub"   → No-op stub (CI/CD, no Nav2 required)
#
# When NAVIGATION_BACKEND=direct, the bridge probes both action servers at
# startup. NavigateToPose is required; FollowWaypoints is optional.
# Single-waypoint tours always use NavigateToPose regardless of FW status.

NAVIGATION_DIRECT_REAL_ENABLED=false
# MUST remain false in offline operation.
# Setting this to true enables physical hardware control paths — prohibited.

# ---------------------------------------------------------------------------
# Nav2 sandbox isolation (WSL only)
# ---------------------------------------------------------------------------
ROS_LOCALHOST_ONLY=1
# Confines all DDS traffic to the loopback interface.
# Required for offline operation to prevent accidental robot DDS discovery.

ROS_DOMAIN_ID=77
# Dedicated domain ID for the offline sandbox. Must NOT be 0.
# Use a value that does not conflict with any physical robot domain.

# ---------------------------------------------------------------------------
# Action server probe timeouts (seconds)
# ---------------------------------------------------------------------------
NAVIGATION_NTP_PROBE_TIMEOUT_S=10.0
# Timeout for NavigateToPose server availability probe at bridge startup.
# Bridge raises RuntimeError if the server is not available within this window.

NAVIGATION_FW_PROBE_TIMEOUT_S=5.0
# Timeout for FollowWaypoints server availability probe at bridge startup.
# A timeout here is non-fatal: bridge logs a warning and disables multi-waypoint
# tours (fw_available=false). Single-waypoint tours continue normally.

# ---------------------------------------------------------------------------
# Navigation stub tours (sandbox / CI)
# ---------------------------------------------------------------------------
NAVIGATION_ALLOW_STUB_TOURS=false
# Set to "true" only when NAVIGATION_BACKEND=stub and you want to allow
# tour dispatch without a real Nav2 backend (e.g. unit-test environments).
# Always false when NAVIGATION_BACKEND=direct.

# ---------------------------------------------------------------------------
# cmd_vel guard
# ---------------------------------------------------------------------------
CMD_VEL_ASSERT_TIMEOUT_S=5
# Timeout (seconds) passed to assert_no_cmd_vel_publishers.sh when probing
# /cmd_vel for active publishers before starting offline read-only sessions.

# ---------------------------------------------------------------------------
# Offline nav readiness layers (informational — checked by GET /status)
# ---------------------------------------------------------------------------
# The GET /status response exposes a layered readiness snapshot:
#
#   navigation_started       : true after DirectNav2ActionBridge.start() completes
#   navigation_ntp_available : true when NavigateToPose was confirmed at startup
#   navigation_fw_available  : true when FollowWaypoints was confirmed at startup
#
# A tour dispatch (POST /tour/start) is blocked if:
#   - fsm_state != idle
#   - navigation backend unavailable or not started
#   - navigation remote state unknown
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ROS 2 distribution (informational — set by sourcing the ROS setup script)
# ---------------------------------------------------------------------------
# Supported for offline sandbox: jazzy (primary), humble (secondary)
# The run_offline_navigation_runtime.sh wrapper sources jazzy first.
# ROS_DISTRO is set automatically by the setup script — do not override.
