# Copiar a .env y ajustar si hace falta.
PORT=3000
MOCK_MODE=true
CORS_ORIGINS=*

# --- Integracion real con el robot (MOCK_MODE=false) ---

# Interfaz de red para la suscripcion DDS al lowstate del robot.
# TODO: Confirmar con `ip addr` en la companion PC del robot (subred 192.168.123.x).
#       Puede llamarse eth0, enp3s0, enpXsY, etc.
#       Si es invalida o no llegan paquetes, cae al mock sin romper el arranque.
DDS_INTERFACE=eth0

# Timeout en segundos: si el lector DDS no recibe ningun frame en este tiempo,
# get_frame() cae al mock para no dejar la UI sin datos.
DDS_TIMEOUT_S=5

# Carpeta del repo de movimiento en el robot, donde vive ./tools/hil/ottoguide-map
ROBOT_REPO_DIR=/home/unitree/Desktop/Ottoguide/OttoGuide-Proyecto_SIP-Grupo6-UADE/codigo ottoguide

# Binario del pipeline conversacional (pilar IA).
# TODO: Confirmar ruta exacta de otto_pipeline en el robot. Si esta en $PATH, dejar asi.
OTTO_PIPELINE_BIN=otto_pipeline
