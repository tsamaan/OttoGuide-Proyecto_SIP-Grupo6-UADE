# Copiar a .env y ajustar segun la topologia (notebook local vs robot/companion PC).
#
# Este frontend (Vite, puerto 3001) es la UNICA UI canonica de OttoGuide. El backend
# FastAPI puede seguir sirviendo un dashboard HTML legacy en modo diagnostico
# (/dashboard-legacy), pero ese dashboard NUNCA debe usarse como interfaz operativa.
#
# --- Perfil activo (por defecto: development, notebook/companion sin robot fisico) ---
VITE_DEPLOYMENT_PROFILE=development
VITE_ROBOT_BASE_URL=http://127.0.0.1:8000
# Arranca en modo simulacion (datos falsos, sin robot). Cambiar a false para usar el robot real.
VITE_MOCK_MODE=false
# Permite alternar mock/real desde la UI. Ignorado (siempre false) si VITE_DEPLOYMENT_PROFILE=real.
VITE_ALLOW_RUNTIME_SWITCH=true

# --- Perfil real: companion PC con robot fisico (192.168.123.164) ---
# Ignora localStorage de mock previo, bloquea el toggle y nunca reemplaza la URL en silencio.
# Descomentar estas lineas y comentar las del perfil activo de arriba.
# VITE_DEPLOYMENT_PROFILE=real
# VITE_ROBOT_BASE_URL=http://192.168.123.164:8000
# VITE_MOCK_MODE=false
# VITE_ALLOW_RUNTIME_SWITCH=false
